{
  "module": {
    "name": "entry",
    "type": "entry",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      { "name": "ohos.permission.INTERNET" },
      { "name": "ohos.permission.GET_NETWORK_INFO" },
      { "name": "ohos.permission.CUSTOM_SCREEN_CAPTURE", "reason": "$string:phone_capture_reason",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } },
      { "name": "ohos.permission.MICROPHONE", "reason": "$string:voice_microphone_reason",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } }
    ],
    "extensionAbilities": [{
      "name": "PhoneAccessibilityAbility", "type": "accessibility",
      "srcEntry": "./ets/phone/PhoneAccessibilityAbility.ets", "label": "$string:app_name",
      "description": "$string:phone_accessibility_reason", "exported": true,
      "metadata": [{ "name": "ohos.accessibleability", "resource": "$profile:phone_accessibility" }]
    }, {
      "name": "CompanionFormAbility", "type": "form",
      "srcEntry": "./ets/companion/CompanionFormAbility.ets", "label": "$string:companion_widget_label",
      "description": "$string:companion_widget_description", "exported": true,
      "metadata": [{ "name": "ohos.extension.form", "resource": "$profile:companion_form" }]
    }],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "metadata": [{ "name": "ohos.ability.shortcuts", "resource": "$profile:shortcuts_config" }],
        "skills": [
          { "entities": ["entity.system.browsable"], "actions": ["ohos.want.action.viewData"],
            "uris": [{ "scheme": "dshgo", "host": "open", "pathStartWith": "/" },
              { "scheme": "dshgo", "host": "share", "pathStartWith": "/" },
              { "scheme": "dshgo", "host": "go.dshtui.com", "pathStartWith": "/c/" },
              { "scheme": "dshgo", "host": "forum", "path": "auth" }] },
          { "actions": ["ohos.want.action.viewData"], "uris": [
              { "scheme": "file", "type": "application/vnd.dshgo+json" },
              { "scheme": "content", "type": "application/vnd.dshgo+json" }] },
          {
            "entities": ["entity.system.home"],
            "actions": ["ohos.want.action.home"]
          }
        ]
      }
    ]
  }
}
