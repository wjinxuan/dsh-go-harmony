interface LocalePattern { expression: RegExp; slots: number[]; translated: string }
function quotedPattern(value: string): string { return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') }
const PATTERNS: LocalePattern[] = Object.keys(ENGLISH).filter((key: string) => /\{\d+\}/.test(key)).sort((a: string,b: string) => b.length-a.length).map((key: string): LocalePattern => {
  const slots: number[] = [], matcher = /\{(\d+)\}/g
  let source = '^', offset = 0, match = matcher.exec(key)
  while (match) { source += quotedPattern(key.substring(offset,match.index))+'([\\s\\S]*?)'; slots.push(Number(match[1])); offset=match.index+match[0].length; match=matcher.exec(key) }
  source += quotedPattern(key.substring(offset))+'$'
  return { expression: new RegExp(source), slots: slots, translated: ENGLISH[key] }
})
export function settingsText(value: string, language: string): string {
  if (!language.toLowerCase().startsWith('en')) return value
  if (ENGLISH[value]) return ENGLISH[value]
  for (const pattern of PATTERNS) {
    const match = pattern.expression.exec(value)
    if (match) { const values: string[] = []; pattern.slots.forEach((slot: number,index: number) => values[slot]=match[index+1]); return fill(pattern.translated,values) }
  }
  return value
}
function fill(value: string, args: (string | number | boolean | null | undefined)[]): string {
  return value.replace(/\{(\d+)\}/g, (_match: string, index: string): string => String(args[Number(index)] ?? ''))
}
export function settingsFormat(value: string, args: (string | number | boolean | null | undefined)[], language: string): string {
  return fill(settingsText(value, language),args)
}
