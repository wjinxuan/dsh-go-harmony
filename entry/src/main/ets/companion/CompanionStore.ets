import { ensurePrivateDirectory } from '../local/PrivateDirectory'
import { common } from '@kit.AbilityKit'
import { preferences } from '@kit.ArkData'
import { fileIo as fs } from '@kit.CoreFileKit'
import { util } from '@kit.ArkTS'
import { array, number, object, string, WireObject } from '../dsh/DshWire'
import { privateBytes, removePrivate, writePrivate } from '../pets/ArchiveFiles'
import { strictPackJson } from '../pets/StrictPackJson'
import { companionPreferences, CompanionPreferences, CompanionLine, CompanionMemory, companionInitial, validateCompanionDocument, companionVersion, companionSnapshot, companionEvent, companionMemory } from './CompanionData'
let queue:Promise<void>=Promise.resolve()
function exclusive<T>(work:()=>Promise<T>):Promise<T>{const run=queue.then(work);queue=run.then(()=>{},()=>{});return run}
export async function loadCompanionPreferences(context:common.Context):Promise<CompanionPreferences>{const prefs=await preferences.getPreferences(context,'dsh-companion');try{return companionPreferences(JSON.parse(prefs.getSync('preferences','{}') as string))}catch{return companionPreferences(undefined)}}
export async function saveCompanionPreferences(context:common.Context,value:CompanionPreferences):Promise<void>{const prefs=await preferences.getPreferences(context,'dsh-companion');prefs.putSync('preferences',JSON.stringify(value));await prefs.flush()}
export async function companionBinding(context:common.Context,host:string,id?:string):Promise<string>{const prefs=await preferences.getPreferences(context,'dsh-companion');let bindings:WireObject;try{bindings=object(JSON.parse(prefs.getSync('bindings','{}') as string))}catch{bindings={}}AppStorage.setOrCreate('dshCompanionBindings',JSON.stringify(bindings));if(id!==undefined){bindings[host]=id;prefs.putSync('bindings',JSON.stringify(bindings));await prefs.flush();AppStorage.setOrCreate('dshCompanionBindings',JSON.stringify(bindings))}return string(bindings[host])}
export async function companionBindingIds(context:common.Context,host?:string):Promise<string[]>{const prefs=await preferences.getPreferences(context,'dsh-companion');try{const bindings=object(JSON.parse(prefs.getSync('bindings','{}') as string));AppStorage.setOrCreate('dshCompanionBindings',JSON.stringify(bindings));if(host!==undefined){const id=string(bindings[host]);return id?[id]:[]}return Object.values(bindings).filter((value:Object|null|undefined)=>typeof value==='string').map((value:Object|null|undefined)=>String(value))}catch{AppStorage.setOrCreate('dshCompanionBindings','{}');return []}}
export class CompanionLocalStore {
 private root:string
 constructor(context:common.Context){this.root=context.filesDir+'/companion'}
 private async read():Promise<WireObject>{const path=this.root+'/light-state.json';if(!await fs.access(path)){const doc=companionInitial(util.generateRandomUUID(),Date.now());await this.write(doc);return doc}try{return validateCompanionDocument(object(strictPackJson(await privateBytes(path,1048576),1048576)))}catch{throw new Error('伙伴状态需要恢复；已保留原文件，可先导出后重置')}}
 private async write(doc:WireObject):Promise<void>{validateCompanionDocument(doc);await this.atomic('light-state.json',JSON.stringify(doc),1048576)}
 private async atomic(name:string,text:string,cap:number):Promise<void>{const bytes=new util.TextEncoder().encodeInto(text);if(bytes.length>cap)throw new Error('伙伴存储超过大小限制');await ensurePrivateDirectory(this.root);const temporary=this.root+'/.write-'+util.generateRandomUUID();try{await writePrivate(temporary,bytes);await fs.rename(temporary,this.root+'/'+name)}finally{await removePrivate(temporary)}}
 snapshot():Promise<WireObject>{return exclusive(async()=>companionSnapshot(await this.read(),Date.now()))}
 event(id:string,revision:number,type:string):Promise<WireObject>{return exclusive(async()=>{const doc=await this.read();if(companionEvent(doc,id,revision,type,Date.now()))await this.write(doc);return companionSnapshot(doc,Date.now())})}
 memories():Promise<WireObject>{return exclusive(async()=>{const doc=await this.read();return{'storeId':doc['storeId'],'revision':doc['revision'],'memoryRevision':doc['memoryRevision'],'memories':doc['memories']} as WireObject})}
 saveMemory(id:string,revision:number,memory:CompanionMemory):Promise<number>{return exclusive(async()=>{const doc=await this.read();companionVersion(doc,id,revision);const entry=companionMemory(memory),records=array(doc['memories']).map(object),index=records.findIndex((r:WireObject)=>string(r['id']).toLowerCase()===entry.id),at=Date.now();if(index<0&&records.length>=256)throw new Error('最多保存 256 条记忆');entry.createdAt=index<0?at:number(records[index]['createdAt'],0);entry.updatedAt=Math.max(at,index<0?0:number(records[index]['updatedAt'],0));const detached=object(JSON.parse(JSON.stringify(entry)));if(index<0)records.push(detached);else records[index]=detached;doc['memories']=records;doc['revision']=number(doc['revision'],0)+1;doc['memoryRevision']=number(doc['memoryRevision'],0)+1;await this.write(doc);return number(doc['revision'],0)})}
 deleteMemory(id:string,revision:number,memoryId:string):Promise<number>{return exclusive(async()=>{const doc=await this.read();companionVersion(doc,id,revision);const records=array(doc['memories']).filter((r:Object)=>string(object(r)['id']).toLowerCase()!==memoryId.toLowerCase());if(records.length!==array(doc['memories']).length){doc['memories']=records;doc['revision']=number(doc['revision'],0)+1;doc['memoryRevision']=number(doc['memoryRevision'],0)+1;await this.write(doc)}return number(doc['revision'],0)})}
 clearMemories(id:string,revision:number):Promise<void>{return exclusive(async()=>{const doc=await this.read();companionVersion(doc,id,revision);if(array(doc['memories']).length){doc['memories']=[];doc['revision']=number(doc['revision'],0)+1;doc['memoryRevision']=number(doc['memoryRevision'],0)+1;await this.write(doc)}})}
 exportState():Promise<string>{return exclusive(async()=>JSON.stringify(await this.read(),null,2))}
 reset(id:string,revision:number):Promise<void>{return exclusive(async()=>{const doc=await this.read();companionVersion(doc,id,revision);await this.write(companionInitial(util.generateRandomUUID(),Date.now()))})}
 lines():Promise<CompanionLine[]>{return exclusive(async()=>{const path=this.root+'/light-chat.json';if(!await fs.access(path))return [];const raw=object(strictPackJson(await privateBytes(path,2097152),2097152));return array(raw['lines']).map((value:Object):CompanionLine=>{const row=object(value);return{role:string(row['role']),text:string(row['text'])}}).filter((line:CompanionLine)=>['user','assistant'].includes(line.role)&&!!line.text).slice(-400)})}
 saveLines(lines:CompanionLine[]):Promise<void>{return exclusive(async()=>{const payload:WireObject={'v':2,'lines':lines.slice(-400)} as WireObject;await this.atomic('light-chat.json',JSON.stringify(payload),2097152)})}
}
export async function companionPrivateRead(context:common.Context,key:string):Promise<string|undefined>{if(!/^[^\x00-\x1f\x7f]{1,1024}$/.test(key))throw new Error('伙伴存储键无效');const prefs=await preferences.getPreferences(context,'dsh-companion');if(!prefs.hasSync(key))return undefined;const value=prefs.getSync(key,'');if(typeof value!=='string')throw new Error('伙伴存储数据无效');return value}
export async function companionPrivateWrite(context:common.Context,key:string,value:string):Promise<void>{if(!/^[^\x00-\x1f\x7f]{1,1024}$/.test(key)||value.length>262144)throw new Error('伙伴存储数据无效');const prefs=await preferences.getPreferences(context,'dsh-companion');prefs.putSync(key,value);await prefs.flush()}
