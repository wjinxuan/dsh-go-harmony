import { number, object, string, WireObject } from '../dsh/DshWire'
export interface CompanionWidgetView {name:string;status:string;line:string;pearls:string;picture:string}
export function companionWidgetView(value:WireObject,now:number=Date.now(),hour:number=new Date(now).getHours()):CompanionWidgetView{const activity=string(value['activity']),busy=!!activity&&activity!=='idle'&&number(value['untilMs'],0)>now,night=hour>=23||hour<6;const bond=Math.max(-1,Math.min(3,Math.floor(number(value['bond'],-1))));const line=now-number(value['saidAt'],0)<43200000&&number(value['saidAt'],0)<=now?string(value['line']).slice(0,80):'';return{name:string(value['name']).slice(0,80)||'Companion',status:string(value[busy?'status':night?'statusAsleep':'statusWaiting']).slice(0,120),line:line,pearls:bond>=0?'●'.repeat(bond+1)+'○'.repeat(3-bond):'',picture:night&&!busy?'sleeping':bond>=2?'happy':'idle'}}
export function companionWidgetUpdate(previous:WireObject,update:WireObject):WireObject{const next:WireObject={};for(const key of ['name','status','activity','untilMs','statusAsleep','statusWaiting','bond','line','saidAt']){const value=Object.keys(update).includes(key)?update[key]:previous[key];if(value===null||value===undefined)continue;if(['untilMs','saidAt','bond'].includes(key)){if(typeof value==='number'&&Number.isFinite(value))next[key]=Math.floor(value)}else if(typeof value==='string')next[key]=value.slice(0,key==='line'?80:120)}return next}
