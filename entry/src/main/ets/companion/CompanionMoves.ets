// Fixed upstream companion_moves.dart, a9877420 (AGPL-3.0).
import { array, object, string, WireObject } from '../dsh/DshWire'
import { parseCompanionReply } from './CompanionData'
export interface CompanionMove { kind:string; raw:string; label:string; ai:boolean }
export function companionMoveLabel(raw:string):string{const name=raw.split('/').pop()!.replace(/\.(exp3|motion3)\.json$/i,'').replace(/^[\s\d_\-.]+/,'').trim();return name||raw}
export function companionMoveFits(label:string):boolean{return !!label&&label.trim()===label&&label.length<=40&&!/[\]】\n]/.test(label)}
function numbered(label:string,n:number):string{const suffix=' '+n,room=40-suffix.length;let kept='';for(const c of Array.from(label)){if(kept.length+c.length>room)break;kept+=c};return kept.trimEnd()+suffix}
function distinct(moves:CompanionMove[]):CompanionMove[]{const taken:Set<string>=new Set();return moves.map((move:CompanionMove):CompanionMove=>{let label=move.label;for(let n=2;taken.has(move.kind+'|'+label.toLowerCase());n++)label=numbered(move.label,n);taken.add(move.kind+'|'+label.toLowerCase());return{kind:move.kind,raw:move.raw,label:label,ai:move.ai}})}
export function companionMoves(info:WireObject,saved:WireObject={}):CompanionMove[]{const moves:CompanionMove[]=[];for(const kind of ['expression','motion'])for(const value of array(info[kind==='expression'?'expressions':'motions'])){if(typeof value!=='string'||!value||value.length>1024)continue;const raw=value,label=companionMoveLabel(raw),kept=object(saved[(kind==='expression'?'e:':'m:')+raw]),suggested=/\p{L}{2,}/u.test(label)&&(kind==='expression'?!/消失|隐藏|水印|切换|开关|显示|hide|toggle|switch|watermark|\boff\b/i.test(label):!/^idle/i.test(raw));moves.push({kind:kind,raw:raw,label:string(kept['label']).trim()||label,ai:typeof kept['ai']==='boolean'?kept['ai'] as boolean:suggested})}return distinct(moves)}
export function companionMoveReplace(moves:CompanionMove[],next:CompanionMove):CompanionMove[]{if(!companionMoveFits(next.label))throw new Error('动作名称需为 1 至 40 字，且不能包含换行或右括号');const taken=new Set(moves.filter((m:CompanionMove)=>m.kind===next.kind&&m.raw!==next.raw).map((m:CompanionMove)=>m.label.toLowerCase()));let label=next.label;for(let n=2;taken.has(label.toLowerCase());n++)label=numbered(next.label,n);return moves.map((m:CompanionMove):CompanionMove=>m.kind===next.kind&&m.raw===next.raw?{kind:next.kind,raw:next.raw,label:label,ai:next.ai}:m)}
export function companionMoveOffered(moves:CompanionMove[],kind:string):CompanionMove[]{return moves.filter((m:CompanionMove)=>m.kind===kind&&m.ai&&companionMoveFits(m.label)&&parseCompanionReply('['+(kind==='expression'?'表情':'动作')+':'+m.label+']').marks.length===0).slice(0,24)}
export function companionMoveLabels(moves:CompanionMove[],kind:string):WireObject{const labels:WireObject={};for(const move of companionMoveOffered(moves,kind))labels[move.label]=move.raw;return labels}
export function companionMoveRules(moves:CompanionMove[]):string{const faces=companionMoveOffered(moves,'expression').map((m:CompanionMove)=>'[表情:'+m.label+']'),actions=companionMoveOffered(moves,'motion').map((m:CompanionMove)=>'[动作:'+m.label+']');if(!faces.length&&!actions.length)return '';return['这个角色还有自己的表情和动作，同样写成标记，界面会执行：',faces.length?'- 表情：'+faces.join(' '):'',actions.length?'- 动作：'+actions.join(' '):''].filter((s:string)=>!!s).join('\n')}
export function companionMovesSave(moves:CompanionMove[]):WireObject{const saved:WireObject={};for(const m of moves)saved[(m.kind==='expression'?'e:':'m:')+m.raw]={'label':m.label,'ai':m.ai} as WireObject;return saved}
