// Fixed upstream C760 gate, translated from a9877420 (AGPL-3.0). No network or model calls.
import type { DshClient } from '../dsh/DshClient'
import { WireObject, object, string, number } from '../dsh/DshWire'
import { CompanionSignal, CompanionSignalCapability, CompanionRunReceipt, signalInt, signalScalar } from '../dsh/CompanionSignalProtocol'
import { CompanionConsent } from './CompanionConsent'
export interface CompanionSignalSource { hostKey:string; client:DshClient|undefined; connection:number; capability:CompanionSignalCapability|undefined; generation:()=>number; attached:()=>boolean; local:boolean }
export interface CompanionSignalIngress { source:CompanionSignalSource; recipient:Object; owner:Object; revision:number }
export interface CompanionSignalEvidence { current:()=>boolean; local:()=>boolean; received:number; pending?:()=>boolean }
export interface CompanionSignalSlot { signal:CompanionSignal; ingress:CompanionSignalIngress; key:string; received:number; expires:number; evidence:CompanionSignalEvidence }
export interface CompanionSignalSpeech { id:string; text:string; voice:boolean; nightCare:boolean; expiresAtMonoMs:number; nightKey?:string; current:()=>boolean; mood:string; action:string }
export interface CompanionSignalPreview { slot:CompanionSignalSlot; text:string; localDetail:boolean }
export interface CompanionSignalShareTarget { recipient:Object; epoch:Object; currentEpoch:()=>Object|undefined; kind:string; keeper?:Object; configuration?:Object; currentKeeper?:()=>Object|undefined; currentConfiguration?:()=>Object|undefined; client?:Object; connection?:number; currentClient?:()=>Object|undefined; currentConnection?:()=>number; binding?:WireObject; currentBinding?:()=>WireObject|undefined; refreshBinding?:()=>Promise<WireObject>; retired?:boolean }
export interface CompanionSignalSharePermit { preview:CompanionSignalPreview; target:CompanionSignalShareTarget; used:boolean }
export function companionSignalTemplate(signal:CompanionSignal,language:string='zh'):string{const zh=language!=='en',p=signal.payload;if(signal.kind==='task.terminal'){const kinds=['completed','output_limit','stopped','interrupted','failed'],i=kinds.indexOf(string(p['phase']));return i<0?(zh?'这一轮的结果尚不明确。':'The turn outcome is unknown.'):(zh?['这一轮已完成。','这一轮已到输出上限。','这一轮已停止。','这一轮已中断。','这一轮未能完成。']:['This turn completed.','This turn reached its output limit.','This turn was stopped.','This turn was interrupted.','This turn could not complete.'])[i]}if(signal.kind==='run.result'){if(p['result']==='succeeded')return p['runKind']==='test'?(zh?'测试命令执行成功，测试数量未知。':'The test command succeeded; test counts are unknown.'):(zh?'构建命令执行成功。':'The build command succeeded.');const kinds=['failed','cancelled','not_run'],i=kinds.indexOf(string(p['result']));return i<0?(zh?'这条命令的结果尚不明确。':'The command outcome is unknown.'):(zh?['这条执行命令失败了。','这条执行命令已取消。','这条命令没有执行。']:['This command failed.','This command was cancelled.','This command was not run.'])[i]}if(signal.kind==='task.approval_waiting')return zh?'有一个请求等你查看。':'A request is waiting for you.';if(signal.kind==='task.approval_cleared')return zh?'这个请求已经结束。':'This request is no longer pending.';if(signal.kind==='app.late_use')return zh?'你还在这里，想歇一会儿也可以。':'You are still here. You can take a break if you want.';return zh?'这项状态暂不可用。':'This status is unavailable.'}
function sameBinding(a:WireObject|undefined,b:WireObject|undefined):boolean{if(!a||!b||a['status']!=='ready'||b['status']!=='ready')return false;return ['bindingId','bridgeEpoch','recallEpoch','storeId','memoryRevision','sessionId'].every((key:string)=>a[key]===b[key])}
export class CompanionSignalGate {
 private clock:()=>number
 private wall:()=>number
 private recipient:Object|undefined=undefined
 private owner:Object|undefined=undefined
 private revision:number=0
 private last:number=-1
 private nonce:number=0
 faulted:boolean=false
 private clearSaturated:boolean=false
 private consents:Map<CompanionSignalSource,CompanionConsent>=new Map()
 private admitted:Map<string,CompanionSignalSlot>=new Map()
 private seen:Set<string>=new Set()
 private cleared:Set<string>=new Set()
 private latestSeq:Map<string,number>=new Map()
 private latestTurn:Map<string,number>=new Map()
 private rates:Map<string,number[]>=new Map()
 private overflows:Map<string,number>=new Map()
 private epochs:Map<Object,CompanionSignalShareTarget>=new Map()
 private ingresses:Set<CompanionSignalIngress>=new Set()
 private previews:Map<CompanionSignalPreview,string>=new Map()
 private permits:Map<CompanionSignalSharePermit,string>=new Map()
 private targetFacts:Map<CompanionSignalShareTarget,WireObject>=new Map()
 constructor(clock:()=>number,wall:()=>number=():number=>Date.now()){this.clock=clock;this.wall=wall}
 private invalidate():void{this.revision++;this.admitted.clear();this.ingresses.clear();this.previews.clear()}
 enter(recipient:Object,owner:Object):void{this.recipient=recipient;this.owner=owner;this.invalidate()}
 leave():void{this.recipient=undefined;this.owner=undefined;this.invalidate()}
 setConsent(source:CompanionSignalSource,value:CompanionConsent):void{if(!this.consents.has(source)&&this.consents.size>=8)return;const old=this.consents.get(source);if(old&&old.state===value.state&&old.optionalSpeech===value.optionalSpeech&&old.voice===value.voice&&old.nightCare===value.nightCare)return;const safe:CompanionConsent={state:value.state,optionalSpeech:value.optionalSpeech,voice:value.voice,nightCare:value.nightCare};this.consents.set(source,safe);this.invalidate()}
 detach(source:CompanionSignalSource):void{if(this.consents.delete(source))this.invalidate()}
 open(source:CompanionSignalSource):CompanionSignalIngress|undefined{if(!this.recipient||!this.owner||this.faulted||this.consents.get(source)?.state!==true)return undefined;const ingress:CompanionSignalIngress={source:source,recipient:this.recipient,owner:this.owner,revision:this.revision};this.ingresses.add(ingress);if(this.current(ingress))return ingress;this.ingresses.delete(ingress);return undefined}
 private pure(ingress:CompanionSignalIngress):boolean{return !this.faulted&&this.ingresses.has(ingress)&&ingress.recipient===this.recipient&&ingress.owner===this.owner&&ingress.revision===this.revision&&this.consents.get(ingress.source)?.state===true&&(ingress.source.local||ingress.source.generation()===ingress.source.connection)}
 current(ingress:CompanionSignalIngress):boolean{if(!this.pure(ingress))return false;let attached=false;try{attached=ingress.source.attached()}catch{}return attached&&this.pure(ingress)}
 private now():number{if(this.faulted)return-1;let value=-1;try{value=this.clock()}catch{}if(!signalInt(value)||value<this.last){this.faulted=true;this.invalidate();return-1}this.last=value;return value}
 slots():CompanionSignalSlot[]{for(const slot of Array.from(this.admitted.values()))if(!this.slotCurrent(slot)&&this.admitted.get(slot.key)===slot)this.admitted.delete(slot.key);return Array.from(this.admitted.values())}
 overflow(host:string):number{return this.overflows.get(host)||0}
 receiveRun(ingress:CompanionSignalIngress,receipt:CompanionRunReceipt):string{const source=ingress.source;if(source.local||!source.client?.ownsCompanionRunReceipt(receipt)||source.client!==receipt.client||source.connection!==receipt.connection||source.capability!==receipt.capability||source.hostKey!==receipt.signal.source['hostKey']||!receipt.capability.available)return'unavailable';if(!receipt.current()||!this.pure(ingress))return'stale';const evidence:CompanionSignalEvidence={current:receipt.current,local:receipt.locallyCurrent,received:receipt.received};return this.admit(ingress,receipt.signal,evidence)}
 receive(ingress:CompanionSignalIngress,signal:CompanionSignal,evidence:CompanionSignalEvidence):string{if(signal.kind==='run.result'||signal.kind==='device.power'||signal.kind.startsWith('notification.'))return'unavailable';if(signal.kind==='task.approval_waiting'&&!evidence.pending)return'rejected';return this.admit(ingress,signal,evidence)}
 private dedup(signal:CompanionSignal,source:CompanionSignalSource):string{const s=signal.source;if(signal.kind==='run.result')return JSON.stringify(['run',source.hostKey,s['sessionId'],s['callId'],s['seq']]);if(signal.kind==='task.terminal')return JSON.stringify(['terminal',source.hostKey,s['sessionId'],s['seq']]);if(signal.kind.startsWith('task.approval_'))return JSON.stringify(['request',source.hostKey,source.connection,s['requestId']]);return JSON.stringify(['local',signal.id])}
 private sequence(signal:CompanionSignal):string{return JSON.stringify([signal.source['hostKey'],signal.source['sessionId'],signal.kind,signal.kind==='run.result'?signal.source['callId']:null])}
 private session(signal:CompanionSignal):string{return JSON.stringify([signal.source['hostKey'],signal.source['sessionId']])}
 private admit(ingress:CompanionSignalIngress,signal:CompanionSignal,evidence:CompanionSignalEvidence):string{
  if(!this.current(ingress))return'stale';const source=ingress.source;if(source.local?signal.kind!=='app.late_use':signal.source['type']!=='dsh'||signal.source['hostKey']!==source.hostKey)return'rejected';if(!evidence.current()||!this.pure(ingress))return'stale';const now=this.now(),received=evidence.received;if(now<0||!signalInt(received)||received>now||!this.pure(ingress))return'stale';const key=this.dedup(signal,source);
  if(signal.kind==='task.approval_cleared'){this.admitted.delete(key);if(this.cleared.size<512||this.cleared.has(key))this.cleared.add(key);else this.clearSaturated=true;return'cleared'}
  if(signal.kind==='task.approval_waiting'&&(this.clearSaturated||this.cleared.has(key)))return'stale';this.slots();if(!this.current(ingress))return'stale';if(this.seen.has(key))return'duplicate';if(this.seen.size>=512){this.admitted.clear();return'capacity'}
  const ttl=signal.kind==='app.late_use'?120000:signal.kind==='task.approval_waiting'?Number.MAX_SAFE_INTEGER:600000;if(now-received>=ttl)return'stale';
  const seq=signal.source['seq'],turn=signal.source['turn'],sequence=this.sequence(signal),session=this.session(signal);if(typeof seq==='number'){if(seq<=(this.latestSeq.get(sequence)??-1)||typeof turn==='number'&&turn<(this.latestTurn.get(session)||0))return'stale';this.latestSeq.set(sequence,seq);if(typeof turn==='number'&&turn>(this.latestTurn.get(session)||0))this.latestTurn.set(session,turn);for(const old of Array.from(this.admitted.values()))if(this.session(old.signal)===session&&(this.sequence(old.signal)===sequence||typeof turn==='number'&&typeof old.signal.source['turn']==='number'&&(old.signal.source['turn'] as number)<turn))this.admitted.delete(old.key)}
  this.seen.add(key);if(typeof seq==='number'){const times=(this.rates.get(source.hostKey)||[]).filter((at:number)=>now-at<60000);this.rates.set(source.hostKey,times);if(times.length>=10){this.overflows.set(source.hostKey,this.overflow(source.hostKey)+1);return'throttled'}times.push(now)}
  const slot:CompanionSignalSlot={signal:signal,ingress:ingress,key:key,received:received,expires:ttl===Number.MAX_SAFE_INTEGER?ttl:received+ttl,evidence:evidence};if(this.admitted.size>=8){const oldest=Array.from(this.admitted.keys())[0];this.admitted.delete(oldest)}this.admitted.set(key,slot);if(!this.slotCurrent(slot)){if(this.admitted.get(key)===slot)this.admitted.delete(key);return'stale'}return'accepted'
 }
 private slotPure(slot:CompanionSignalSlot,now:number,speech:boolean):boolean{const s=slot.signal.source;return this.admitted.get(slot.key)===slot&&slot.evidence.local()&&this.pure(slot.ingress)&&now>=slot.received&&now<slot.expires&&(!speech||now<slot.received+120000)&&(typeof s['seq']!=='number'||this.latestSeq.get(this.sequence(slot.signal))===s['seq'])&&(typeof s['turn']!=='number'||(s['turn'] as number)>=(this.latestTurn.get(this.session(slot.signal))||0))}
 slotCurrent(slot:CompanionSignalSlot,speech:boolean=false):boolean{let now=this.now();if(now<0||!this.slotPure(slot,now,speech)||!this.current(slot.ingress))return false;try{if(!slot.evidence.current()||slot.evidence.pending&&!slot.evidence.pending())return false;if(slot.signal.kind==='app.late_use'){const shifted=new Date(this.wall()+number(slot.signal.payload['utcOffsetMinutes'],0)*60000),hour=shifted.getUTCHours();if(hour>=7&&hour<23)return false;if(hour<7)shifted.setUTCDate(shifted.getUTCDate()-1);if(shifted.toISOString().slice(0,10)!==slot.signal.payload['nightKey'])return false}}catch{return false}now=this.now();return now>=0&&this.slotPure(slot,now,speech)}
 speech(slot:CompanionSignalSlot,language:string='zh'):CompanionSignalSpeech|undefined{if(!this.slotCurrent(slot,true)||slot.signal.freshness!=='live'||!['task.terminal','run.result','app.late_use'].includes(slot.signal.kind))return undefined;const consent=this.consents.get(slot.ingress.source);if(!consent?.optionalSpeech)return undefined;const text=companionSignalTemplate(slot.signal,language);if(Array.from(text).length>(language==='en'?80:40))return undefined;const voice=consent.voice,nightCare=consent.nightCare;const current=():boolean=>this.slotCurrent(slot,true)&&this.consents.get(slot.ingress.source)?.optionalSpeech===true&&this.consents.get(slot.ingress.source)?.voice===voice&&this.consents.get(slot.ingress.source)?.nightCare===nightCare;const failed=slot.signal.payload['phase']==='failed'||slot.signal.payload['result']==='failed'||slot.signal.kind==='app.late_use';const speech:CompanionSignalSpeech={id:'signal-'+(++this.nonce),text:text,voice:voice,nightCare:nightCare,expiresAtMonoMs:slot.received+120000,nightKey:slot.signal.kind==='app.late_use'?string(slot.signal.payload['nightKey']):undefined,current:current,mood:failed?'worried':'happy',action:failed?'tilt':'nodSmall'};return current()?speech:undefined}
 preview(slot:CompanionSignalSlot,language:string='zh'):CompanionSignalPreview|undefined{if(!this.slotCurrent(slot))return undefined;const preview:CompanionSignalPreview={slot:slot,text:companionSignalTemplate(slot.signal,language),localDetail:false};this.previews.set(preview,preview.text);return preview}
 async detail(slot:CompanionSignalSlot,loader:(client:Object,session:string,seq:number)=>Promise<string|undefined>):Promise<CompanionSignalPreview|undefined>{const s=slot.signal.source,client=slot.ingress.source.client;if(!this.slotCurrent(slot)||!client||!['task.terminal','run.result'].includes(slot.signal.kind)||typeof s['seq']!=='number')return undefined;let text:string|undefined;try{text=await loader(client,string(s['sessionId']),s['seq'] as number)}catch{return undefined}if(!text||text.length>4096||!signalScalar(text,true)||/[\x00-\x08\x0b\x0c\x0e-\x1f\x7f-\x9f]/.test(text)||!this.slotCurrent(slot))return undefined;const preview:CompanionSignalPreview={slot:slot,text:text,localDetail:true};this.previews.set(preview,preview.text);return preview}
 private targetPure(target:CompanionSignalShareTarget):boolean{const fact=this.targetFacts.get(target);return !!fact&&fact['recipient']===target.recipient&&fact['epoch']===target.epoch&&fact['client']===target.client&&fact['connection']===target.connection&&fact['keeper']===target.keeper&&fact['configuration']===target.configuration&&fact['kind']===target.kind&&fact['binding']===JSON.stringify(target.binding)&&!target.retired&&this.epochs.get(target.epoch)===target&&(target.kind!=='full'||target.currentConnection?.()===target.connection&&target.binding?.['status']==='ready')}
 private targetCurrent(target:CompanionSignalShareTarget):boolean{if(target.retired)return false;const old=this.epochs.get(target.epoch);if(old&&old!==target||!old&&this.epochs.size>=512){target.retired=true;return false}if(!old){const fact:WireObject={'recipient':target.recipient,'epoch':target.epoch,'client':target.client,'connection':target.connection,'keeper':target.keeper,'configuration':target.configuration,'kind':target.kind,'binding':JSON.stringify(target.binding)};this.targetFacts.set(target,fact)}this.epochs.set(target.epoch,target);let valid=false;try{valid=target.kind==='light'?!!target.keeper&&!!target.configuration&&target.currentKeeper?.()===target.keeper&&target.currentConfiguration?.()===target.configuration:target.kind==='full'&&!!target.client&&target.currentClient?.()===target.client&&target.currentConnection?.()===target.connection&&sameBinding(target.currentBinding?.(),target.binding);valid=target.currentEpoch()===target.epoch&&valid}catch{}if(!valid||!this.targetPure(target)){target.retired=true;return false}return true}
 private shareCurrent(preview:CompanionSignalPreview,target:CompanionSignalShareTarget):boolean{if(this.previews.get(preview)!==preview.text||preview.slot.ingress.recipient!==target.recipient||!this.slotCurrent(preview.slot)||!this.targetCurrent(target))return false;const now=this.now();return now>=0&&this.slotPure(preview.slot,now,false)&&this.targetPure(target)}
 approve(preview:CompanionSignalPreview,target:CompanionSignalShareTarget,confirmed:boolean):CompanionSignalSharePermit|undefined{if(!confirmed||!this.shareCurrent(preview,target))return undefined;const permit:CompanionSignalSharePermit={preview:preview,target:target,used:false};this.permits.set(permit,preview.text);return permit}
 async dispatch(permit:CompanionSignalSharePermit,send:(text:string,target:CompanionSignalShareTarget,current:()=>boolean)=>Promise<boolean>):Promise<boolean>{const approved=this.permits.get(permit);if(approved===undefined||permit.used)return false;this.permits.delete(permit);permit.used=true;const current=():boolean=>permit.preview.text===approved&&this.shareCurrent(permit.preview,permit.target);if(!current())return false;try{if(permit.target.kind==='full'){const fresh=await permit.target.refreshBinding?.();if(!sameBinding(fresh,permit.target.binding)){permit.target.retired=true;return false}}else await Promise.resolve();if(!current())return false;const result=await send(approved,permit.target,current);return result&&current()}catch{return false}}
}

export class CompanionSignalLateUse {
 private wall:number=-1
 private mono:number=-1
 private offset:number=0
 private resumed:boolean=false
 private interaction:number=-1
 private night:string=''
 activeMs:number=0
 faulted:boolean=false
 private reset():void{this.night='';this.activeMs=0;this.interaction=-1}
 private nightKey(wall:number,offset:number):string{const d=new Date(wall+offset*60000);if(d.getUTCHours()>=7&&d.getUTCHours()<23)return'';if(d.getUTCHours()<7)d.setUTCDate(d.getUTCDate()-1);return d.toISOString().slice(0,10)}
 observe(wall:number,mono:number,offset:number,resumed:boolean,interaction:boolean=false):WireObject|undefined{if(this.faulted)return undefined;if(!signalInt(wall,0,8640000000000000-3*86400000)||!signalInt(mono,0,Number.MAX_SAFE_INTEGER-86400000)||!signalInt(offset,-840,840)||this.wall>=0&&(wall<this.wall||mono<this.mono)){this.faulted=true;this.reset();return undefined}if(this.wall>=0){if(Math.abs((wall-this.wall)-(mono-this.mono))>1000||offset!==this.offset)this.reset();else if(this.resumed&&this.interaction>=0){const end=Math.min(mono,this.interaction+120000);if(end>this.mono){const d=new Date(this.wall+offset*60000);let start=Date.UTC(d.getUTCFullYear(),d.getUTCMonth(),d.getUTCDate(),23)-offset*60000;if(d.getUTCHours()<7)start-=86400000;const from=Math.max(this.wall,start),to=Math.min(this.wall+end-this.mono,start+8*3600000);if(to>from){const key=this.nightKey(start,offset);if(this.night!==key){this.night=key;this.activeMs=0}this.activeMs=Math.min(900000,this.activeMs+to-from)}}}}this.wall=wall;this.mono=mono;this.offset=offset;this.resumed=resumed;const key=this.nightKey(wall,offset);if(!key||this.night&&key!==this.night){this.night=key;this.activeMs=0}if(!resumed){this.interaction=-1;return undefined}if(interaction)this.interaction=mono;if(this.interaction<0||mono-this.interaction>120000||!key||this.night!==key||this.activeMs<900000)return undefined;const payload:WireObject={'nightKey':key,'utcOffsetMinutes':offset,'recentInteraction':true,'activeMinutesBucket':'15plus'};return payload}
}
