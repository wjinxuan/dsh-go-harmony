import { util } from '@kit.ArkTS'
import { rcp } from '@kit.RemoteCommunicationKit'
import { asset } from '@kit.AssetStoreKit'
import { BusinessError } from '@kit.BasicServicesKit'
import { array, object, string, WireObject } from '../dsh/DshWire'
import { CompanionLine } from './CompanionData'
function keyQuery():asset.AssetMap{const query:asset.AssetMap=new Map();query.set(asset.Tag.ALIAS,new util.TextEncoder().encodeInto('dsh-go.companion.deepseek.v1'));return query}
export async function companionHasKey():Promise<boolean>{const query=keyQuery();query.set(asset.Tag.RETURN_TYPE,asset.ReturnType.ATTRIBUTES);try{return(await asset.query(query)).length===1}catch(error){if((error as BusinessError).code===asset.ErrorCode.NOT_FOUND)return false;throw new Error('请解锁手机后访问安全存储')}}
export async function companionSaveKey(value:string):Promise<void>{const key=value.trim();if(!key||key.length>4096||/[\s\x00-\x1f\x7f]/.test(key))throw new Error('API Key 格式无效');const bytes=new util.TextEncoder().encodeInto(key);try{const query=keyQuery();const update:asset.AssetMap=new Map();update.set(asset.Tag.SECRET,bytes);if(await companionHasKey())await asset.update(query,update);else{query.set(asset.Tag.SECRET,bytes);query.set(asset.Tag.ACCESSIBILITY,asset.Accessibility.DEVICE_UNLOCKED);query.set(asset.Tag.SYNC_TYPE,asset.SyncType.NEVER);query.set(asset.Tag.CONFLICT_RESOLUTION,asset.ConflictResolution.THROW_ERROR);await asset.add(query)}}finally{bytes.fill(0)}}
export async function companionRemoveKey():Promise<void>{try{await asset.remove(keyQuery())}catch(error){if((error as BusinessError).code!==asset.ErrorCode.NOT_FOUND)throw new Error('API Key 未能移除')}}
async function readKey():Promise<string>{const query=keyQuery();query.set(asset.Tag.RETURN_TYPE,asset.ReturnType.ALL);let rows:asset.AssetMap[];try{rows=await asset.query(query)}catch{throw new Error('请先设置 DeepSeek API Key 并解锁手机')}const bytes=rows[0]?.get(asset.Tag.SECRET);if(!(bytes instanceof Uint8Array)||!bytes.length||bytes.length>4096)throw new Error('请先设置 DeepSeek API Key');try{return util.TextDecoder.create('utf-8').decodeToString(bytes)}finally{bytes.fill(0)}}
export class CompanionSse {
 private carry:string='';private data:string[]=[];private stopped:boolean=false;private length:number=0
 push(chunk:string):string[]{if(this.stopped)return [];this.carry+=chunk;if(this.carry.length>262144)throw new Error('伙伴回复数据过大');const deltas:string[]=[];let newline:number
 while((newline=this.carry.indexOf('\n'))>=0){let line=this.carry.slice(0,newline);this.carry=this.carry.slice(newline+1);if(line.endsWith('\r'))line=line.slice(0,-1);if(line.startsWith('data:'))this.data.push(line.slice(5).trimStart());else if(!line){const payload=this.data.join('\n');this.data=[];if(!payload||payload==='[DONE]')continue;let row:WireObject;try{row=object(JSON.parse(payload))}catch{continue}if(row['type']==='error'||row['error'])throw new Error('伙伴服务返回错误，请重试');if(row['type']==='message_stop'){this.stopped=true;continue}if(row['type']==='content_block_delta'){const delta=object(row['delta']);if(delta['type']==='text_delta'){const text=string(delta['text']);this.length+=text.length;if(this.length>262144)throw new Error('伙伴回复过长');deltas.push(text)}}}}
 return deltas
 }
 complete():boolean{return this.stopped}
}
export class CompanionLightRequest {
 private session:rcp.Session|undefined=undefined
 private request:rcp.Request|undefined=undefined
 private cancelReason:string=''
 cancel():void{this.cancelReason='请求已取消';if(this.session&&this.request){try{this.session.cancel(this.request)}catch{}}this.session?.close();this.session=undefined}
 async run(system:string,lines:CompanionLine[],context:WireObject,onDelta:(text:string)=>void,maxTokens:number=800,current:()=>boolean=():boolean=>true):Promise<void>{this.cancelReason='';if(!current())throw new Error('伙伴目标已变更');const key=await readKey();if(this.cancelReason||!current())throw new Error(this.cancelReason||'伙伴目标已变更');const session=rcp.createSession({requestConfiguration:{transfer:{autoRedirect:false,timeout:{connectMs:30000,transferMs:180000}}}});this.session=session
 const messages:WireObject[]=lines.slice(-24).map((line:CompanionLine):WireObject=>({'role':line.role,'content':[{'type':'text','text':line.text} as WireObject]} as WireObject));while(messages.length&&messages[0]['role']!=='user')messages.shift();if(Object.keys(context).length&&messages.length){const last=messages[messages.length-1],content=array(last['content']);const safe=JSON.stringify(context).replace(/</g,'\\u003c').replace(/>/g,'\\u003e').replace(/&/g,'\\u0026');last['content']=[{'type':'text','text':'<companion_context>'+safe+'</companion_context>'} as WireObject,...content]}
 const body:WireObject={'model':'deepseek-flash','stream':true,'max_tokens':Math.max(1,Math.min(3000,Math.floor(maxTokens))),'thinking':{'type':'disabled'} as WireObject,'system':system,'messages':messages} as WireObject;const request=new rcp.Request('https://api.deepseek.com/anthropic/v1/messages','POST',{'content-type':'application/json','accept':'text/event-stream','x-api-key':key,'anthropic-version':'2023-06-01'} as rcp.RequestHeaders,JSON.stringify(body));this.request=request;const parser=new CompanionSse(),decoder=util.TextDecoder.create('utf-8');let failure='',accepted=false,timer=-1
 const fail=(reason:string):void=>{failure=reason;try{session.cancel(request)}catch{}};const pulse=():void=>{clearTimeout(timer);timer=setTimeout(()=>fail('伙伴回复超时，请重试'),45000)}
 const events:rcp.HttpEventsHandler={onStatusCodeReceive:(status:number):void=>{if(status!==200)fail(status===401||status===403?'API Key 无效':status===429?'服务繁忙，请稍后重试':'伙伴服务请求失败（HTTP '+status+'）')},onHeaderReceive:(headers:rcp.ResponseHeaders):void=>{const type=headers['content-type'];accepted=typeof type==='string'&&/^text\/event-stream(?:\s*;|$)/i.test(type);if(!accepted)fail('伙伴服务返回了无效类型')},onDataReceive:(data:ArrayBuffer):void=>{if(!current()){fail('伙伴目标已变更');return}if(!accepted||failure||this.cancelReason)return;pulse();try{for(const delta of parser.push(decoder.decodeWithStream(new Uint8Array(data),{stream:true})))onDelta(delta)}catch(error){fail(String(error))}}}
 request.configuration={transfer:{autoRedirect:false,timeout:{connectMs:30000,transferMs:180000}},tracing:{httpEventsHandler:events}};pulse();try{if(!current()||this.cancelReason)throw new Error(this.cancelReason||'伙伴目标已变更');await session.fetch(request);if(failure||this.cancelReason)throw new Error(failure||this.cancelReason);if(!parser.complete())throw new Error('伙伴回复未完整结束，请重试')}catch(error){throw new Error(failure||this.cancelReason||(error instanceof Error?error.message:'伙伴网络请求失败'))}finally{clearTimeout(timer);session.close();if(this.session===session){this.session=undefined;this.request=undefined}}
 }
}
