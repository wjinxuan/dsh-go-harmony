// Original arrival greeting, a9877420 companion_reply.dart / companion_page.dart.
export interface CompanionGreeting { text:string; emotion:string; action:string }
export function companionGreeting(now:number,lastSeen:number|undefined,name:string='',language:string='zh'):CompanionGreeting{const en=!language.startsWith('zh'),away=lastSeen===undefined?0:now-lastSeen,hour=new Date(now).getHours();let kind=lastSeen===undefined?'first':away<1200000?'back':away>259200000?'long':hour<5||hour>=23?'late':hour<11?'morning':hour<14?'noon':hour<18?'afternoon':'evening';const keys=['first','morning','noon','afternoon','evening','late','long','back'],index=keys.indexOf(kind);const zh=[name?'你好呀，我是'+name+'。以后就住在这里了，请多指教。':'你好呀，以后我就住在这里了，请多指教。','早呀，今天也要好好吃早饭。','中午啦，吃过饭了吗？','下午好，我刚才在发呆。','晚上好，今天过得怎么样？','这么晚还没睡呀？','好久不见，我还以为你把我忘啦。','嗯？又回来啦。'];const english=[name?"Hi, I'm "+name+'. I live here now, nice to meet you.':'Hi, I live here now. Nice to meet you.',"Morning! Don't skip breakfast today.","It's noon already. Have you eaten?",'Good afternoon. I was just daydreaming.','Good evening. How was your day?','Still up this late?',"It's been a while! I thought you'd forgotten me.",'Hm? Back again.'];return{text:(en?english:zh)[index],emotion:['shy','happy','calm','calm','happy','worried','surprised','calm'][index],action:['wave','wave','tilt','nodSmall','wave','tilt','hop','nodSmall'][index]}}
