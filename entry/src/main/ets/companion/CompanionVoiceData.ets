import { array, object, string, WireObject } from '../dsh/DshWire'
export interface CompanionVoiceSettings { on:boolean; source:string; preset:string; presetVoices:Record<string,string>; presetStyle:string; cloneOn:boolean; cloneSample:string; openaiBase:string; openaiModel:string; openaiVoice:string; customUrl:string; customPost:boolean; customBody:string; customField:string }
export interface CompanionVoicePreset { id:string; name:string; voices:string[]; styled:boolean; clones:boolean }
export const COMPANION_VOICE_PRESETS:CompanionVoicePreset[]=[{id:'mimo',name:'小米 MiMo',voices:['冰糖','茉莉','苏打','白桦','mimo_default','Mia','Chloe','Milo','Dean'],styled:true,clones:true},{id:'openai',name:'OpenAI',voices:['coral','nova','shimmer','sage','alloy','ash','ballad','echo','fable','onyx','verse'],styled:true,clones:false},{id:'siliconflow',name:'硅基流动',voices:['claire','diana','anna','bella','alex','benjamin','charles','david'],styled:false,clones:false},{id:'bailian',name:'阿里云百炼',voices:['Cherry','Ethan','Jennifer','Ryan'],styled:false,clones:false}]
export function companionVoiceSettings(value?:Object):CompanionVoiceSettings{const row=object(value),voices=object(row['presetVoices']),kept:Record<string,string>={};for(const preset of COMPANION_VOICE_PRESETS)if(typeof voices[preset.id]==='string')kept[preset.id]=string(voices[preset.id]).slice(0,256);return{on:row['on']===true,source:['system','preset','openai','custom'].includes(string(row['source']))?string(row['source']):'system',preset:COMPANION_VOICE_PRESETS.some((p:CompanionVoicePreset)=>p.id===row['preset'])?string(row['preset']):'mimo',presetVoices:kept,presetStyle:string(row['presetStyle']).slice(0,2000),cloneOn:row['cloneOn']===true,cloneSample:['wav','mp3'].includes(string(row['cloneSample']))?string(row['cloneSample']):'',openaiBase:string(row['openaiBase'])||'https://api.openai.com/v1',openaiModel:string(row['openaiModel'])||'gpt-4o-mini-tts',openaiVoice:string(row['openaiVoice'])||'alloy',customUrl:string(row['customUrl']),customPost:row['customPost']!==false,customBody:typeof row['customBody']==='string'?string(row['customBody']):'{"text":"{text}"}',customField:string(row['customField'])}}
export interface CompanionVoiceRequest { url:string; method:string; headers:Record<string,string>; body:string|undefined; field:string }
export function companionVoiceTarget(value:string):string{if(!/^https?:\/\/[^\s/?#@]+(?:[/?][^\s#]*)?$/.test(value)||/[\x00-\x20\x7f]/.test(value))throw new Error('语音服务地址无效');return value}
export function companionVoiceRequest(settings:CompanionVoiceSettings,text:string,key:string,customHeaders:string='',clone:string=''):CompanionVoiceRequest{
 if(!text.trim()||text.length>8000)throw new Error('语音文本长度无效');let source=settings.source,base=settings.openaiBase.trim().replace(/\/+$/,''),model=settings.openaiModel.trim(),voice=settings.openaiVoice.trim(),instructions='',url=settings.customUrl.trim(),body=settings.customBody,field=settings.customField.trim(),headers:Record<string,string>={},post=settings.customPost
 if(source==='preset'){const preset=COMPANION_VOICE_PRESETS.find((p:CompanionVoicePreset)=>p.id===settings.preset)||COMPANION_VOICE_PRESETS[0];voice=clone||settings.presetVoices[preset.id]||preset.voices[0];if(!key.trim())throw new Error('请先保存语音服务 API Key');const style=settings.presetStyle.trim()||'用自然、温柔、带一点俏皮的少女语气说，像在陪朋友聊天。';if(preset.id==='openai'){source='openai';base='https://api.openai.com/v1';model='gpt-4o-mini-tts';instructions=style}else if(preset.id==='siliconflow'){source='openai';base='https://api.siliconflow.cn/v1';model='FunAudioLLM/CosyVoice2-0.5B';if(!voice.includes(':'))voice=model+':'+voice}else{source='custom';post=true;if(preset.id==='mimo'){url='https://api.xiaomimimo.com/v1/chat/completions';headers['api-key']=key;headers['Authorization']='Bearer '+key;body=JSON.stringify({'model':clone?'mimo-v2.5-tts-voiceclone':'mimo-v2.5-tts','messages':[{'role':'user','content':style} as WireObject,{'role':'assistant','content':'{text}'} as WireObject],'audio':{'format':'wav','voice':voice} as WireObject} as WireObject);field='choices.0.message.audio.data'}else{url='https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation';headers['Authorization']='Bearer '+key;body=JSON.stringify({'model':'qwen3-tts-flash','input':{'text':'{text}','voice':voice} as WireObject} as WireObject);field='output.audio.url'}}}
 if(source==='openai'){if(!model||!voice)throw new Error('请填写语音模型与音色');const payload:WireObject={'model':model,'input':text,'voice':voice,'response_format':'wav'} as WireObject;if(instructions)payload['instructions']=instructions;headers['content-type']='application/json';if(key.trim())headers['authorization']='Bearer '+key.trim();return{url:companionVoiceTarget(base+'/audio/speech'),method:'POST',headers:headers,body:JSON.stringify(payload),field:''}}
 if(source!=='custom')throw new Error('系统语音无需网络请求');if(settings.source==='custom')for(const line of customHeaders.split(/\r?\n/)){if(!line.trim())continue;const colon=line.indexOf(':');if(colon<1)throw new Error('语音请求头格式无效');const name=line.slice(0,colon).trim(),value=line.slice(colon+1).trim();if(!/^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/.test(name)||/[\r\n\x00]/.test(value)||['host','cookie','content-length','connection'].includes(name.toLowerCase()))throw new Error('语音请求头格式无效');headers[name]=value}url=url.split('{text}').join(encodeURIComponent(text));if(post&&!Object.keys(headers).some((name:string)=>name.toLowerCase()==='content-type'))headers['content-type']='application/json';const escaped=JSON.stringify(text);return{url:companionVoiceTarget(url),method:post?'POST':'GET',headers:headers,body:post?body.split('{text}').join(escaped.slice(1,-1)):undefined,field:field}
}
export function companionAudioField(value:Object,path:string):string{let node:Object|null|undefined=value;for(const step of path.split('.')){if(Array.isArray(node)){if(!/^\d+$/.test(step))throw new Error('语音响应字段不存在');node=array(node)[Number(step)]}else if(!['__proto__','constructor','prototype'].includes(step))node=object(node)[step];else throw new Error('语音响应字段无效')}if(typeof node!=='string'||!node)throw new Error('语音响应字段不存在');return node}
export function companionAudioKind(bytes:Uint8Array):string{const at=(index:number,magic:string):boolean=>bytes.length>=index+magic.length&&magic.split('').every((char:string,i:number)=>bytes[index+i]===char.charCodeAt(0));if(at(0,'RIFF')&&at(8,'WAVE'))return'wav';if(at(0,'ID3')||(bytes.length>1&&bytes[0]===255&&(bytes[1]&224)===224))return'mp3';if(at(0,'OggS'))return'ogg';if(at(0,'fLaC'))return'flac';if(at(4,'ftyp'))return'm4a';return'bin'}
export interface CompanionSpeakable {text:string;next:number}
export function companionSpeakable(words:string,from:number,final:boolean):CompanionSpeakable{if(from>=words.length)return{text:'',next:words.length};const rest=words.slice(from);if(final)return{text:rest.trim(),next:words.length};let end=0;for(let index=0;index<rest.length;index++)if(/[。！？!?…~～\n]/.test(rest.charAt(index)))end=index+1;return{text:rest.slice(0,end).trim(),next:from+end}}
export function companionLoudness(wav:Uint8Array):number[]{if(companionAudioKind(wav)!=='wav')return[];const data=new DataView(wav.buffer,wav.byteOffset,wav.byteLength);let channels=0,rate=0,bits=0,start=0,length=0,offset=12;while(offset+8<=wav.length){const id=String.fromCharCode(wav[offset],wav[offset+1],wav[offset+2],wav[offset+3]);let size=data.getUint32(offset+4,true),body=offset+8;if(id==='fmt '&&body+16<=wav.length){if(data.getUint16(body,true)!==1)return[];channels=data.getUint16(body+2,true);rate=data.getUint32(body+4,true);bits=data.getUint16(body+14,true)}else if(id==='data'){start=body;if(!size||size===4294967295||body+size>wav.length)size=wav.length-body;length=size;break}offset=body+size+(size%2)}if(!channels||channels>32||rate<1000||rate>384000||bits!==16||!start)return[];const frameSamples=Math.max(1,Math.floor(rate*.04)),stride=2*channels,count=Math.floor(length/stride),levels:number[]=[];let peak=0;for(let first=0;first<count;first+=frameSamples){let sum=0,last=Math.min(count,first+frameSamples);for(let i=first;i<last;i++){const sample=data.getInt16(start+i*stride,true)/32768;sum+=sample*sample}const rms=Math.sqrt(sum/(last-first));levels.push(rms);peak=Math.max(peak,rms)}return levels.map((value:number)=>peak<.0001||value/peak<.12?0:Math.pow(value/peak,.7)*.9)}
