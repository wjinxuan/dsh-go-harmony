import { ensurePrivateDirectory } from '../local/PrivateDirectory'
import { common } from '@kit.AbilityKit'
import { preferences } from '@kit.ArkData'
import { util } from '@kit.ArkTS'
import { asset } from '@kit.AssetStoreKit'
import { BusinessError } from '@kit.BasicServicesKit'
import { fileIo as fs } from '@kit.CoreFileKit'
import { rcp } from '@kit.RemoteCommunicationKit'
import { media } from '@kit.MediaKit'
import { textToSpeech } from '@kit.CoreSpeechKit'
import { privateBytes, removePrivate, writePrivate } from '../pets/ArchiveFiles'
import { WireObject } from '../dsh/DshWire'
import { CompanionVoiceSettings, companionVoiceSettings, companionVoiceRequest, companionAudioField, companionAudioKind, companionLoudness, companionVoiceTarget } from './CompanionVoiceData'
function voiceQuery(id:string):asset.AssetMap{if(!['mimo','openai','siliconflow','bailian','compatible','headers'].includes(id))throw new Error('语音凭据名称无效');const query:asset.AssetMap=new Map();query.set(asset.Tag.ALIAS,new util.TextEncoder().encodeInto('dsh-go.companion.voice.'+id));return query}
export async function saveCompanionVoiceSecret(id:string,value:string):Promise<void>{if(value.length>16384||/[\x00]/.test(value)||(id!=='headers'&&/[\s\x00-\x1f\x7f]/.test(value)))throw new Error('语音凭据格式无效');const query=voiceQuery(id);if(!value){try{await asset.remove(query)}catch(error){if((error as BusinessError).code!==asset.ErrorCode.NOT_FOUND)throw new Error('语音凭据未能移除')}return}const bytes=new util.TextEncoder().encodeInto(value);try{const attributes=voiceQuery(id);attributes.set(asset.Tag.RETURN_TYPE,asset.ReturnType.ATTRIBUTES);let exists=false;try{exists=(await asset.query(attributes)).length>0}catch(error){if((error as BusinessError).code!==asset.ErrorCode.NOT_FOUND)throw new Error('请解锁手机后访问安全存储')}const fields:asset.AssetMap=new Map();fields.set(asset.Tag.SECRET,bytes);if(exists)await asset.update(query,fields);else{query.set(asset.Tag.SECRET,bytes);query.set(asset.Tag.ACCESSIBILITY,asset.Accessibility.DEVICE_UNLOCKED);query.set(asset.Tag.SYNC_TYPE,asset.SyncType.NEVER);query.set(asset.Tag.CONFLICT_RESOLUTION,asset.ConflictResolution.THROW_ERROR);await asset.add(query)}}finally{bytes.fill(0)}}
async function voiceSecret(id:string):Promise<string>{const query=voiceQuery(id);query.set(asset.Tag.RETURN_TYPE,asset.ReturnType.ALL);try{const rows=await asset.query(query),value=rows[0]?.get(asset.Tag.SECRET);if(!(value instanceof Uint8Array))return'';try{return util.TextDecoder.create('utf-8').decodeToString(value)}finally{value.fill(0)}}catch(error){if((error as BusinessError).code===asset.ErrorCode.NOT_FOUND)return'';throw new Error('请解锁手机后访问安全存储')}}
export async function loadCompanionVoice(context:common.Context):Promise<CompanionVoiceSettings>{const prefs=await preferences.getPreferences(context,'dsh-companion');try{return companionVoiceSettings(JSON.parse(prefs.getSync('voice','{}') as string))}catch{return companionVoiceSettings()}}
export async function saveCompanionVoice(context:common.Context,value:CompanionVoiceSettings):Promise<void>{const prefs=await preferences.getPreferences(context,'dsh-companion');prefs.putSync('voice',JSON.stringify(companionVoiceSettings(value)));await prefs.flush()}
export async function keepCompanionRecording(context:common.Context,bytes:Uint8Array):Promise<string>{if(bytes.length>7340032||!bytes.length)throw new Error('录音不能超过 7 MiB');const kind=companionAudioKind(bytes);if(!['wav','mp3'].includes(kind))throw new Error('请选择 WAV 或 MP3 录音');const root=context.filesDir+'/companion';await ensurePrivateDirectory(root);const temporary=root+'/voice-sample.part';try{await writePrivate(temporary,bytes);await fs.rename(temporary,root+'/voice-sample.'+kind);await removePrivate(root+'/voice-sample.'+(kind==='wav'?'mp3':'wav'));return kind}finally{await removePrivate(temporary)}}
export async function removeCompanionRecording(context:common.Context):Promise<void>{await removePrivate(context.filesDir+'/companion/voice-sample.wav');await removePrivate(context.filesDir+'/companion/voice-sample.mp3')}
export interface CompanionVoiceEvent {type:string;text:string;level:number;reason:string}
export class CompanionSpeaker {
 private context:common.Context
 private settings:CompanionVoiceSettings=companionVoiceSettings()
 private queue:string[]=[]
 private active:boolean=false
 private generation:number=0
 private http:rcp.Session|undefined=undefined
 private player:media.AVPlayer|undefined=undefined
 private engine:textToSpeech.TextToSpeechEngine|undefined=undefined
 private language:string=''
 private finish:(error?:Error)=>void=()=>{}
 private closed:boolean=false
 private onEvent:(event:CompanionVoiceEvent)=>void
 constructor(context:common.Context,onEvent:(event:CompanionVoiceEvent)=>void){this.context=context;this.onEvent=onEvent}
 configure(settings:CompanionVoiceSettings):void{this.stop();this.settings=settings}
 speak(text:string):void{if(this.closed||!this.settings.on||!text.trim())return;for(let offset=0;offset<text.length;offset+=1800)this.queue.push(text.slice(offset,offset+1800));if(!this.active)void this.drain()}
 stop():void{this.generation++;this.queue=[];this.http?.close();this.http=undefined;this.finish(new Error('语音播放已停止'));try{this.engine?.stop()}catch{}void this.player?.release().catch(()=>{});this.player=undefined;this.emit('stopped')}
 close():void{this.closed=true;this.stop();try{this.engine?.shutdown()}catch{}this.engine=undefined}
 private emit(type:string,text:string='',level:number=0,reason:string=''):void{if(!this.closed)this.onEvent({type:type,text:text,level:level,reason:reason})}
 private async drain():Promise<void>{this.active=true;const generation=this.generation;try{while(this.queue.length&&!this.closed&&generation===this.generation){const text=this.queue.shift()!;try{if(this.settings.source==='system')await this.system(text,generation);else{try{const bytes=await this.fetchAudio(text,generation);if(generation===this.generation)await this.play(bytes,text,generation)}catch(error){if(generation!==this.generation)return;this.emit('fallback',text,0,error instanceof Error?error.message:'语音服务请求失败');await this.system(text,generation)}}}catch(error){if(generation===this.generation)this.emit('error',text,0,error instanceof Error?error.message:'无法播放语音')}}}finally{this.active=false;if(this.queue.length&&!this.closed)void this.drain()}}
 private async system(text:string,generation:number):Promise<void>{const language=/[\u3400-\u9fff]/.test(text)?'zh-CN':'en-US';if(!this.engine||this.language!==language){this.engine?.shutdown();this.engine=await textToSpeech.createEngine({language:language,person:language==='zh-CN'?13:8,online:1});this.language=language}if(generation!==this.generation)return;const engine=this.engine,id=util.generateRandomUUID().replace(/-/g,'');await new Promise<void>((resolve,reject)=>{let done=false;const timer=setTimeout(()=>end(new Error('系统语音播放超时')),120000);const end=(error?:Error):void=>{if(done)return;done=true;clearTimeout(timer);this.finish=()=>{};this.emit('done');if(error)reject(error);else resolve()};this.finish=end;const listener:textToSpeech.SpeakListener={onStart:(requestId:string):void=>{if(requestId===id)this.emit('start',text)},onComplete:(requestId:string):void=>{if(requestId===id)end()},onStop:(requestId:string):void=>{if(requestId===id)end()},onError:(requestId:string):void=>{if(requestId===id)end(new Error('系统语音不可用，请检查语音包'))}};engine.setListener(listener);try{engine.speak(text,{requestId:id,extraParams:{'pitch':1.12,'speed':1.0,'volume':1.0} as WireObject})}catch{end(new Error('系统语音不可用，请检查语音包'))}})}
 private async requestAudio(url:string,method:string,headers:Record<string,string>,body?:string):Promise<Uint8Array>{const session=rcp.createSession({requestConfiguration:{transfer:{autoRedirect:false,timeout:{connectMs:10000,transferMs:20000}}}});this.http=session;const request=new rcp.Request(companionVoiceTarget(url),method,headers,body);let total=0,failure='',chunks:Uint8Array[]=[];const events:rcp.HttpEventsHandler={onStatusCodeReceive:(status:number):void=>{if(status!==200){failure='语音服务请求失败（HTTP '+status+'）';try{session.cancel(request)}catch{}}},onDataReceive:(buffer:ArrayBuffer):void=>{if(failure)return;total+=buffer.byteLength;if(total>20971520){failure='语音响应超过 20 MiB';try{session.cancel(request)}catch{}return}chunks.push(new Uint8Array(buffer).slice())}};request.configuration={transfer:{autoRedirect:false,timeout:{connectMs:10000,transferMs:20000}},tracing:{httpEventsHandler:events}};try{await session.fetch(request);if(failure)throw new Error(failure);const bytes=new Uint8Array(total);let offset=0;for(const chunk of chunks){bytes.set(chunk,offset);offset+=chunk.length}return bytes}catch(error){throw new Error(failure||(error instanceof Error?error.message:'语音服务请求失败'))}finally{chunks=[];session.close();if(this.http===session)this.http=undefined}}
 private async fetchAudio(text:string,generation:number):Promise<Uint8Array>{const settings=this.settings,key=await voiceSecret(settings.source==='preset'?settings.preset:'compatible'),headers=settings.source==='custom'?await voiceSecret('headers'):'';let clone='';if(settings.source==='preset'&&settings.preset==='mimo'&&settings.cloneOn){if(!settings.cloneSample)throw new Error('请先导入自己的声音录音');const sample=await privateBytes(this.context.filesDir+'/companion/voice-sample.'+settings.cloneSample,7340032);const mime=companionAudioKind(sample)==='wav'?'audio/wav':'audio/mpeg';clone='data:'+mime+';base64,'+new util.Base64Helper().encodeToStringSync(sample)}if(generation!==this.generation)throw new Error('语音播放已停止');const request=companionVoiceRequest(settings,text,key,headers,clone);let bytes=await this.requestAudio(request.url,request.method,request.headers,request.body);if(request.field){const value=companionAudioField(JSON.parse(util.TextDecoder.create('utf-8').decodeToString(bytes)),request.field);if(/^https?:\/\//.test(value)){if(generation!==this.generation)throw new Error('语音播放已停止');bytes=await this.requestAudio(value,'GET',{})}else{const encoded=value.startsWith('data:')?value.slice(value.indexOf(',')+1):value;if(encoded.length>27962028)throw new Error('语音响应超过 20 MiB');try{bytes=new util.Base64Helper().decodeSync(encoded.replace(/\s/g,''))}catch{throw new Error('语音响应不是有效音频')}}}if(!bytes.length||bytes.length>20971520||companionAudioKind(bytes)==='bin')throw new Error('语音响应不是有效音频');return bytes}
 private async play(bytes:Uint8Array,text:string,generation:number):Promise<void>{const path=this.context.cacheDir+'/companion-voice-'+util.generateRandomUUID()+'.'+companionAudioKind(bytes);await writePrivate(path,bytes);let file:fs.File|undefined=undefined,player:media.AVPlayer|undefined=undefined;let levelTimer=-1;try{if(generation!==this.generation)return;file=await fs.open(path,fs.OpenMode.READ_ONLY);player=await media.createAVPlayer();if(generation!==this.generation)return;this.player=player;const current=player,levels=companionLoudness(bytes);await new Promise<void>((resolve,reject)=>{let done=false;const timeout=setTimeout(()=>end(new Error('语音播放超时')),180000);const end=(error?:Error):void=>{if(done)return;done=true;clearTimeout(timeout);clearInterval(levelTimer);this.finish=()=>{};this.emit('done');if(error)reject(error);else resolve()};this.finish=end;current.on('error',()=>end(new Error('音频播放失败')));current.on('stateChange',(state:string)=>{if(state==='initialized')void current.prepare().catch(()=>end(new Error('音频准备失败')));else if(state==='prepared')void current.play().catch(()=>end(new Error('音频播放失败')));else if(state==='playing'){this.emit('start',text);let index=0;levelTimer=setInterval(()=>{if(index<levels.length)this.emit('level','',levels[index++])},40)}else if(state==='completed')end()});current.fdSrc={fd:file!.fd,offset:0,length:bytes.length}})}finally{clearInterval(levelTimer);if(this.player===player)this.player=undefined;await player?.release().catch(()=>{});if(file)await fs.close(file);await removePrivate(path)}}
}
