import { array, number, object, string, WireObject } from '../dsh/DshWire'
interface CodexTrack {frames:WireObject[];loop:boolean}
export interface CodexPet {json:WireObject;sheet:string;height:number;warnings:string[]}
function check(ok:boolean,key:string):void {if(!ok)throw new Error('Codex 宠物包无效：'+key)}
export function convertCodexPet(metadata:WireObject,sha:string):CodexPet {
 const version=metadata['spriteVersionNumber']??1;check(version===1||version===2,'version');const height=version===1?1872:2288
 for(const key of ['id','displayName','description','author','license','source','spritesheetPath'])check(metadata[key]===undefined||metadata[key]===null||typeof metadata[key]==='string',key)
 const sheet=string(metadata['spritesheetPath']).trim()?string(metadata['spritesheetPath']):'spritesheet.webp';check(sheet.length<=120&&!sheet.startsWith('.')&&!/[\\/\x00]/.test(sheet)&&/\.(png|webp)$/i.test(sheet),'sheet')
 const raw=metadata['frame'];let width=192,frameHeight=208,cols=8,rows=version===1?9:11
 if(raw!==undefined&&raw!==null){const grid=object(raw),values=[grid['width'],grid['height'],grid['columns'],grid['rows']];check(values.every((v:Object|null|undefined)=>typeof v==='number'&&Number.isInteger(v)&&Number(v)>0&&Number(v)<=4096),'grid');width=Number(values[0]);frameHeight=Number(values[1]);cols=Number(values[2]);rows=Number(values[3]);check(width*cols===1536&&frameHeight*rows===height&&cols*rows<=256,'grid');check(version!==2||width===192&&frameHeight===208&&cols===8&&rows===11,'v2-grid')}
 const tracks:Map<string,CodexTrack>=new Map();const make=(row:number,count:number,ms:number,last:number):CodexTrack=>{const frames:WireObject[]=[];for(let i=0;i<count;i++)frames.push({'i':row*8+i,'ms':i===count-1?last:ms} as WireObject);return{frames:frames,loop:true}}
 tracks.set('idle',{frames:[1680,660,660,840,840,1920].map((ms:number,i:number):WireObject=>({'i':i,'ms':ms} as WireObject)),loop:true})
 tracks.set('running-right',make(1,8,120,220));tracks.set('running-left',make(2,8,120,220));tracks.set('waving',make(3,4,140,280));tracks.set('jumping',make(4,5,140,280));tracks.set('failed',make(5,8,140,240));tracks.set('waiting',make(6,6,150,260));tracks.set('running',make(7,6,120,220));tracks.set('review',make(8,6,150,280))
 for(const pair of [['move_right','running-right'],['move_left','running-left'],['wave','waving'],['bounce','jumping'],['sad','failed']])tracks.set(pair[0],tracks.get(pair[1])!)
 const warnings=['dsh-state-loops-replace-codex-settle-to-idle','roam-left-mirrors-right-track','drag-direction-uses-right-track','sleep-uses-first-idle-frame'];if(version===2)warnings.push('look-directions-not-bound');if(/\.webp$/i.test(sheet))warnings.push('webp-transcoded-to-png')
 check(metadata['animations']!==null,'animations');const overrides=object(metadata['animations']);if(metadata['animations']!==undefined)check(typeof metadata['animations']==='object'&&!Array.isArray(metadata['animations']),'animations');check(version!==2||Object.keys(overrides).length===0,'v2-animations')
 for(const key of Object.keys(overrides)){const row=object(overrides[key]),frames=array(row['frames']),fps=number(row['fps'],8),loop=row['loop']??true,fallback=row['fallback']??'';check(frames.length>0&&frames.every((v:Object)=>typeof v==='number'&&Number.isInteger(v)&&Number(v)>=0&&Number(v)<256)&&Number.isFinite(fps)&&fps>0&&fps<=60&&typeof loop==='boolean'&&typeof fallback==='string','track');check(!fallback||tracks.has(String(fallback))||Object.keys(overrides).includes(String(fallback)),'fallback');check(loop===true||!fallback||fallback==='idle','fallback');const ms=Math.round(1000/fps);check(ms>0&&ms*frames.length<=2147483647,'duration');if(ms!==1000/fps&&!warnings.includes('fps-rounded-to-milliseconds'))warnings.push('fps-rounded-to-milliseconds');if(!loop&&!warnings.includes('one-shot-return-controlled-by-dsh'))warnings.push('one-shot-return-controlled-by-dsh');if(!['idle','running-right','waving','jumping','failed','waiting','running','review'].includes(key)&&!warnings.includes('custom-tracks-not-bound'))warnings.push('custom-tracks-not-bound');tracks.set(key,{frames:frames.map((i:Object):WireObject=>({'i':Number(i),'ms':ms} as WireObject)),loop:loop===true})}
 const animations:WireObject={},timings:WireObject={},keptSheet=sheet.replace(/\.webp$/i,'.png');for(const key of Array.from(tracks.keys())){const track=tracks.get(key)!;check(track.frames.every((f:WireObject)=>number(f['i'],0)<cols*rows),'index');animations[key]={'sheet':keptSheet,'frameW':width,'frameH':frameHeight,'cols':cols,'box':{'x':0,'y':0,'w':width,'h':frameHeight} as WireObject,'loop':track.loop,'frames':track.frames} as WireObject;timings[key]=track.frames.reduce((n:number,f:WireObject)=>n+number(f['ms'],0),0)}
 let sleep='dsh-sleep';while(tracks.has(sleep))sleep+='-';animations[sleep]={'sheet':keptSheet,'frameW':width,'frameH':frameHeight,'cols':cols,'box':{'x':0,'y':0,'w':width,'h':frameHeight} as WireObject,'loop':true,'frames':[{'i':tracks.get('idle')!.frames[0]['i'],'ms':1000} as WireObject]} as WireObject
 const id=string(metadata['id']).trim()||'codex-'+sha.slice(0,16);const result:WireObject={'schema':1,'id':id,'name':string(metadata['displayName']).trim()||id,'description':metadata['description'],'pixelArt':false,'scale':1,'canvas':{'w':width,'h':frameHeight} as WireObject,'anchor':{'x':Math.floor(width/2),'baseline':frameHeight} as WireObject,'contentBox':{'x':0,'y':0,'w':width,'h':frameHeight} as WireObject,'animations':animations,'states':{'idle':['idle'],'thinking':['waiting'],'working':['running'],'juggling':['running'],'notification':['waiting'],'attention':['review'],'error':['failed'],'sweeping':['running'],'carrying':['running'],'sleeping':[sleep],'waking':['jumping']} as WireObject,'reactions':{'tapLeft':'waving','tapRight':'waving','tickle':'jumping','drag':'running-right'} as WireObject,'roam':{'anim':'running-right','faces':'right'} as WireObject,'timings':{'playMs':timings} as WireObject,'codexImport':{'profile':version===1?'codex-cli-v1':'work-fixed-v2','spriteVersionNumber':version,'sourceSheet':sheet,'sourceSha256':sha,'warnings':warnings} as WireObject} as WireObject
 for(const key of ['author','license','source']){result[key]=metadata[key];if(!string(metadata[key]).trim())warnings.push('missing-'+key)}return{json:result,sheet:sheet,height:height,warnings:warnings}
}
