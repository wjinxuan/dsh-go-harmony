 private client:DshClient;private host:string;private sessions:()=>DshSession[];private onChange:(rows:PetSessionSnapshot[])=>void;private identity:number;private active:boolean=false;private stop:DshSubscription|undefined=undefined
 private rows:Map<string,PetSessionSnapshot>=new Map();private parents:Map<string,string>=new Map();private asks:Map<string,string>=new Map();private versions:Map<string,number>=new Map();private counter:number=0;private focusedSubagents:Map<string,number>=new Map()
