import { ensurePrivateDirectory } from '../local/PrivateDirectory'
import { common } from '@kit.AbilityKit'
import { fileIo as fs } from '@kit.CoreFileKit'
import { preferences } from '@kit.ArkData'
import { image } from '@kit.ImageKit'
import { util } from '@kit.ArkTS'
import { object, string, WireObject } from '../dsh/DshWire'
import { BUILTIN_PETS, parsePetPack, PetPack, PetPreferences, petPreferences } from './PetData'
import { PrivateArchive } from './PrivateArchive'
import { strictPackJson } from './StrictPackJson'
import { inflateBounded, inflatePrivate, privateBytes, privateSha256, removePrivate, writePrivate } from './ArchiveFiles'
import { validatePetPng, validateStaticWebp } from './PetPng'
import { convertCodexPet } from './CodexPet'
let work:Promise<void>=Promise.resolve()
function serial<T>(job:()=>Promise<T>):Promise<T>{const run=work.then(job);work=run.then(()=>{},()=>{});return run}
const validId=(id:string):boolean=>/^user-[a-z0-9]+(?:-[a-z0-9]+)*$/.test(id)&&id.length<=100
const encode=(value:string):Uint8Array=>new util.TextEncoder().encodeInto(value)
async function exists(path:string):Promise<boolean>{try{return await fs.access(path)}catch{return false}}
export async function loadPetPreferences(context:common.Context,preferEnabled:boolean=true):Promise<PetPreferences>{const store=await preferences.getPreferences(context,'dsh-pets');try{return petPreferences(JSON.parse(store.getSync('prefs','{}') as string),preferEnabled)}catch{return petPreferences(undefined,preferEnabled)}}
export async function savePetPreferences(context:common.Context,value:PetPreferences):Promise<void>{const store=await preferences.getPreferences(context,'dsh-pets');const raw:WireObject={'size':value.size,'quiet':value.quiet,'position':value.position,'hiddenUntil':value.hiddenUntil,'overlay':value.overlay,'overlayMode':value.overlayMode,'overlayPosition':value.overlayPosition,'overlayHiddenUntil':value.overlayHiddenUntil};if(value.explicit)raw['packId']=value.packId;store.putSync('prefs',JSON.stringify(raw));await store.flush();AppStorage.setOrCreate('dshPetRevision',(AppStorage.get<number>('dshPetRevision')||0)+1)}
async function tidy(root:string):Promise<void>{await ensurePrivateDirectory(root);const names=await fs.listFile(root);const backups=names.filter((n:string)=>/^\.old-\d+-user-/.test(n)).sort().reverse();for(const name of backups){const id=name.replace(/^\.old-\d+-/,'');if(!validId(id))continue;if(!await exists(root+'/'+id))await fs.rename(root+'/'+name,root+'/'+id);else await removePrivate(root+'/'+name)}for(const name of names)if(name.startsWith('.trash-')||name.startsWith('.staging-'))await removePrivate(root+'/'+name)}
async function readPet(context:common.Context,id:string):Promise<PetPack>{if(BUILTIN_PETS.includes(id))return parsePetPack(strictPackJson(await context.resourceManager.getRawFileContent('pets/'+id+'/pack.json')));if(!validId(id))throw new Error('宠物包名称无效');const directory=context.filesDir+'/pets/'+id;const pack=parsePetPack(strictPackJson(await privateBytes(directory+'/pack.json',262144)),directory);if(pack.id!==id)throw new Error('宠物包标识不一致');return pack}
export function loadPet(context:common.Context,id:string):Promise<PetPack>{return serial(async()=>{await tidy(context.filesDir+'/pets');return readPet(context,id)})}
export function listPets(context:common.Context):Promise<PetPack[]>{return serial(async()=>{const root=context.filesDir+'/pets';await tidy(root);const packs:PetPack[]=[];for(const id of BUILTIN_PETS)packs.push(await readPet(context,id));const dates:Map<string,number>=new Map();for(const id of await fs.listFile(root)){if(!validId(id))continue;try{dates.set(id,(await fs.stat(root+'/'+id)).mtime)}catch{}}for(const id of Array.from(dates.keys()).sort((a:string,b:string)=>(dates.get(a)||0)-(dates.get(b)||0)||a.localeCompare(b))){try{packs.push(await readPet(context,id))}catch{}}return packs})}
export function petSheetBytes(context:common.Context,pack:PetPack,sheet:string):Promise<Uint8Array>{return pack.directory?privateBytes(pack.directory+'/'+sheet,8388608):context.resourceManager.getRawFileContent('pets/'+pack.id+'/'+sheet)}
async function safeId(packId:string):Promise<string>{const bare=packId.startsWith('user-')?packId.slice(5):packId;if(bare.length<=48&&/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(bare))return 'user-'+bare;let slug=bare.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,32).replace(/-+$/,'');return 'user-'+(slug||'pet')+'-'+(await privateSha256(encode(packId))).slice(0,8)}
async function decodePng(bytes:Uint8Array):Promise<Uint8Array>{const info=await validatePetPng(bytes,(b:Uint8Array,cap:number)=>inflateBounded(b,cap));const source=image.createImageSource(info.rendering.buffer);try{if(await source.getFrameCount()!==1)throw new Error('宠物图集不能是动图');const pixels=await source.createPixelMap();try{const actual=await pixels.getImageInfo();if(actual.size.width!==info.width||actual.size.height!==info.height)throw new Error('宠物图集解码失败')}finally{pixels.release()}return bytes}finally{source.release()}}
async function webpToPng(bytes:Uint8Array,height:number):Promise<Uint8Array>{validateStaticWebp(bytes,1536,height);const source=image.createImageSource(bytes.buffer);const packer=image.createImagePacker();try{const info=await source.getImageInfo();if(info.size.width!==1536||info.size.height!==height||await source.getFrameCount()!==1)throw new Error('Codex 图集尺寸不正确');const result=await packer.packing(source,{format:'image/png',quality:100});if(result.byteLength>8388608)throw new Error('宠物图集过大');return new Uint8Array(result)}finally{source.release();packer.release()}}
export function installPet(context:common.Context,bytes:Uint8Array):Promise<PetPack>{return serial(async()=>{
 const root=context.filesDir+'/pets';await tidy(root);const archive=new PrivateArchive(bytes);const manifests=archive.manifests('pack.json');let raw:WireObject,prefix='',codexSheet='',codexPng:Uint8Array|undefined=undefined
 if(manifests.length){if(manifests.length!==1)throw new Error('压缩包应只包含一个 pack.json');prefix=manifests[0].slice(0,-9);raw=object(strictPackJson(await archive.read(manifests[0],inflatePrivate,262144)))}
 else {const candidates=archive.manifests('pet.json');if(candidates.length!==1)throw new Error('压缩包缺少 pack.json 或 pet.json');prefix=candidates[0].slice(0,-8);const metadata=object(strictPackJson(await archive.read(candidates[0],inflatePrivate,262144)));const path=string(metadata['spritesheetPath']).trim()?string(metadata['spritesheetPath']):'spritesheet.webp';if(path.startsWith('.')||/[\\/\x00]/.test(path))throw new Error('Codex 图集名称无效');const source=await archive.read(prefix+path,inflatePrivate,8388608);const converted=convertCodexPet(metadata,await privateSha256(source));raw=converted.json;codexSheet=path.replace(/\.webp$/i,'.png');codexPng=/\.webp$/i.test(path)?await webpToPng(source,converted.height):source}
 const pack=parsePetPack(raw);const sheets:Map<string,Uint8Array>=new Map();let total=0
 for(const anim of pack.animations){if(sheets.has(anim.sheet))continue;const bytes=codexPng&&anim.sheet===codexSheet?codexPng:await archive.read(prefix+anim.sheet,inflatePrivate,8388608);await decodePng(bytes);const view=new DataView(bytes.buffer,bytes.byteOffset,bytes.byteLength),w=view.getUint32(16),h=view.getUint32(20);for(const a of pack.animations.filter((a)=>a.sheet===anim.sheet)){if(a.cols*a.frameW>w||a.frames.some((f)=>Math.floor(f.i/a.cols)*a.frameH+a.frameH>h))throw new Error('宠物帧超出图集')}total+=bytes.length;if(total>50331648)throw new Error('宠物图集总大小超过限制');sheets.set(anim.sheet,bytes)}
 const id=await safeId(pack.id),stamp=Date.now().toString(),stage=root+'/.staging-'+stamp,live=root+'/'+id,backup=root+'/.old-'+stamp+'-'+id;raw['id']=id;raw['scale']=pack.scale;raw['pixelArt']=pack.pixelArt;const encoded=encode(JSON.stringify(raw));if(encoded.length>262144)throw new Error('宠物描述过大');await fs.mkdir(stage,true)
 let moved=false;try{for(const name of Array.from(sheets.keys()))await writePrivate(stage+'/'+name,sheets.get(name)!);await writePrivate(stage+'/pack.json',encoded);if(await exists(live)){await fs.rename(live,backup);moved=true}try{await fs.rename(stage,live)}catch(error){if(moved)await fs.rename(backup,live);throw error as Error}await removePrivate(backup);AppStorage.setOrCreate('dshPetRevision',(AppStorage.get<number>('dshPetRevision')||0)+1);return parsePetPack(raw,live)}finally{await removePrivate(stage)}
})}
export function removePet(context:common.Context,id:string):Promise<void>{return serial(async()=>{if(!validId(id))throw new Error('只能移除导入的宠物');const root=context.filesDir+'/pets';await tidy(root);if(await exists(root+'/'+id)){const trash=root+'/.trash-'+Date.now()+'-'+id;await fs.rename(root+'/'+id,trash);await removePrivate(trash)}const prefs=await loadPetPreferences(context);if(prefs.packId===id){prefs.packId='deepy-whale';prefs.explicit=true;await savePetPreferences(context,prefs)}AppStorage.setOrCreate('dshPetRevision',(AppStorage.get<number>('dshPetRevision')||0)+1)})}
