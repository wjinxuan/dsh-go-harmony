    {
      "id": "media-result-job-terminal-state",
      "problem": "Historical running media metadata remained immutable while watchJobs updated only progress. The old card still showed a spinner and Cancel after the same job completed or was killed. A separate final media card did not retire the old action.",
      "historicalRecordSemantics": "Keeping the initial generate_video and later get_media_result tool records is intentional. This fix follows the real known job status without rewriting historical media metadata or creating result items.",
      "upstreamReview": {
        "commit": "a9877420ab9aee121134faf01b6a92a39ce0b05b",
        "references": [
          "app/lib/ui/chat/media/media_card.dart (progress subscription and _StateBox)",
          "docs/design/media-generation.md (job.status determines state)",
          "runtime/vendor/dsh-media/src/index.js (initial generate_video and later get_media_result records)"
        ],
        "finding": "Fixed Flutter baseline subscribes to progress but its _StateBox has no cancel action. The native cancel action must follow the actual live job status."
      },
      "change": [
        "Reuse existing jobLive/jobStatus parsing and localized labels.",
        "Known completed/killed/failed stops the spinner, clears stale progress, hides cancel, and closes the subscription.",
        "Missing or unknown jobs do not synthesize completion or result items.",
        "Cancellation acknowledgement enters stopping; delayed running snapshots cannot reverse that acknowledgement.",
        "Late stream, subscription, cancel success/error/finally callbacks are fenced by generation, connection, session and job identity.",
        "Already-finished kill response uses a generic ended state without claiming a successful media result."
      ],
